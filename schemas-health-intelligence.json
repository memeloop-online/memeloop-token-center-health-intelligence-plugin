{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memeloop.dev/plugins/mtc-health-intelligence/v1/snapshot.schema.json",
  "title": "Health and intelligence snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "pageUrl",
        "endpoint",
        "status",
        "fetchedAt",
        "sourceUpdatedAt",
        "attempts",
        "error",
        "rows",
        "maxObservationAgeSeconds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "pageUrl": {
          "type": "string",
          "pattern": "^https://[^\\s/@?#\\\\]+(?:/[^\\s?#\\\\]*)?$",
          "format": "uri"
        },
        "endpoint": {
          "type": "string",
          "pattern": "^https://[^\\s/@?#\\\\]+(?:/[^\\s?#\\\\]*)?$",
          "format": "uri"
        },
        "status": {
          "enum": [
            "ok",
            "stale",
            "error"
          ]
        },
        "fetchedAt": {
          "type": "string"
        },
        "sourceUpdatedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "rows": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              }
            },
            "additionalProperties": {
              "maxLength": 256,
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "maxProperties": 32
          }
        },
        "maxObservationAgeSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
