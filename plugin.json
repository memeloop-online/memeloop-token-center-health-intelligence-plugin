{
  "id": "mtc-health-intelligence",
  "version": "1.1.0",
  "wit_version": "0.2.0",
  "wasm": null,
  "capabilities": [
    {
      "kind": "http",
      "allowed_origins": [
        "https://memeloop-online.github.io"
      ]
    }
  ],
  "contributions": {
    "traffic_policy": false,
    "request_rewrite": false,
    "configuration": null,
    "providers": [],
    "service_data": [
      {
        "id": "health-intelligence",
        "url": "https://memeloop-online.github.io/memeloop-token-center-health-intelligence-plugin/api/health-intelligence.json",
        "required_scope": "metrics:read",
        "response_schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://memeloop.dev/plugins/mtc-health-intelligence/v1/snapshot.schema.json",
          "title": "Health and intelligence snapshot",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "generatedAt",
            "sources"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "generatedAt": {
              "type": "string"
            },
            "sources": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/source"
              }
            }
          },
          "$defs": {
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "pageUrl",
                "endpoint",
                "status",
                "fetchedAt",
                "sourceUpdatedAt",
                "attempts",
                "error",
                "rows",
                "maxObservationAgeSeconds"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "pageUrl": {
                  "type": "string",
                  "pattern": "^https://[^\\s/@?#\\\\]+(?:/[^\\s?#\\\\]*)?$",
                  "format": "uri"
                },
                "endpoint": {
                  "type": "string",
                  "pattern": "^https://[^\\s/@?#\\\\]+(?:/[^\\s?#\\\\]*)?$",
                  "format": "uri"
                },
                "status": {
                  "enum": [
                    "ok",
                    "stale",
                    "error"
                  ]
                },
                "fetchedAt": {
                  "type": "string"
                },
                "sourceUpdatedAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "attempts": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 12
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 256
                },
                "rows": {
                  "type": "array",
                  "maxItems": 24,
                  "items": {
                    "type": "object",
                    "required": [
                      "key"
                    ],
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 180
                      }
                    },
                    "additionalProperties": {
                      "maxLength": 256,
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    },
                    "maxProperties": 32
                  }
                },
                "maxObservationAgeSeconds": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "fallback": {
          "schemaVersion": 1,
          "generatedAt": "1970-01-01T00:00:00.000Z",
          "sources": [
            {
              "id": "codexradar",
              "label": "Codex Radar 模型能力",
              "pageUrl": "https://codexradar.com/",
              "endpoint": "https://codexradar.com/api/radar-insights",
              "status": "error",
              "fetchedAt": "1970-01-01T00:00:00.000Z",
              "sourceUpdatedAt": null,
              "attempts": 0,
              "error": "service unavailable",
              "rows": [],
              "maxObservationAgeSeconds": 604800
            },
            {
              "id": "deepswe",
              "label": "DeepSWE 工程能力",
              "pageUrl": "https://deepswe.datacurve.ai/",
              "endpoint": "https://deepswe.datacurve.ai/artifacts/v1.1/leaderboard-live.json",
              "status": "error",
              "fetchedAt": "1970-01-01T00:00:00.000Z",
              "sourceUpdatedAt": null,
              "attempts": 0,
              "error": "service unavailable",
              "rows": [],
              "maxObservationAgeSeconds": 2592000
            },
            {
              "id": "aixhan",
              "label": "CDK 模型健康",
              "pageUrl": "https://cdk.aixhan.com/model-health",
              "endpoint": "https://cdk.aixhan.com/api/public/check-cx/dashboard",
              "status": "error",
              "fetchedAt": "1970-01-01T00:00:00.000Z",
              "sourceUpdatedAt": null,
              "attempts": 0,
              "error": "service unavailable",
              "rows": [],
              "maxObservationAgeSeconds": 1200
            }
          ]
        },
        "cache_ttl_seconds": 300,
        "timeout_millis": 4000,
        "max_body_bytes": 1048576
      }
    ],
    "operator_ui": [
      {
        "id": "health-and-intelligence",
        "slot": "operator.sidebar.tab",
        "category": {
          "id": "monitoring"
        },
        "route": "health-intelligence",
        "label": "模型健康与能力",
        "icon": "heart",
        "renderer": "component_v1",
        "module_entry": "ui/health-intelligence.mjs",
        "component_id": "health-intelligence",
        "data_endpoint": "health-intelligence"
      }
    ]
  }
}
